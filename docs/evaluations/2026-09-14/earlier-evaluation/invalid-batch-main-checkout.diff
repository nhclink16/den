+#[cfg(test)]
+mod tests {
+    use super::*;
+    use clap::Parser;
+    fn msg(n: u64) -> Message {
+        Message {
+            id: format!("{n:026}"),
+            channel_id: "01CHANNEL000000000000000".into(),
+            author_id: "01AUTHOR0000000000000000".into(),
+            content: format!("m{n}"),
+            reply_to: None,
+            created_at: String::new(),
+            edited_at: None,
+            attachments: Vec::new(),
+            objects: Vec::new(),
+            reactions: Vec::new(),
+            mention_ids: Vec::new(),
+        }
+    }
+    fn ids(messages: &[Message]) -> Vec<u64> {
+        messages.iter().map(|m| m.id.parse().unwrap()).collect()
+    }
+    /// Simulates the server over message IDs 1..=total, recording cursors.
+    fn server(
+        total: u64,
+        limit: u32,
+        calls: std::rc::Rc<std::cell::RefCell<Vec<(Option<String>, Option<String>)>>>,
+    ) -> impl FnMut(Option<&str>, Option<&str>) -> anyhow::Result<Vec<Message>> {
+        move |before, after| {
+            calls
+                .borrow_mut()
+                .push((before.map(str::to_string), after.map(str::to_string)));
+            let matching = (1..=total).filter(|i| {
+                let id = format!("{i:026}");
+                before.is_none_or(|b| id.as_str() < b) && after.is_none_or(|a| id.as_str() > a)
+            });
+            let page: Vec<u64> = if after.is_some() {
+                matching.take(limit as usize).collect()
+            } else {
+                let mut page: Vec<u64> = matching.rev().take(limit as usize).collect();
+                page.reverse();
+                page
+            };
+            Ok(page.into_iter().map(msg).collect())
+        }
+    }
+    #[test]
+    fn read_parses_all_flag() {
+        let cli = Cli::try_parse_from(["den", "read", "general", "--all"]).unwrap();
+        let Cmd::Read { all, limit, .. } = cli.cmd else {
+            panic!("expected read")
+        };
+        assert!(all);
+        assert_eq!(limit, 50);
+    }
+    #[test]
+    fn read_all_walks_backwards_from_newest() {
+        let calls = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+        let messages = read_all_pages(None, None, 100, server(250, 100, calls.clone())).unwrap();
+        assert_eq!(ids(&messages), (1..=250).collect::<Vec<_>>());
+        let calls = calls.borrow();
+        assert_eq!(calls.len(), 3);
+        assert_eq!(calls[0], (None, None));
+        assert_eq!(calls[1].0.as_deref(), Some(&msg(151).id[..]));
+        assert_eq!(calls[2].0.as_deref(), Some(&msg(51).id[..]));
+    }
+    #[test]
+    fn read_all_walks_forwards_from_after() {
+        let calls = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+        let start = msg(100).id;
+        let messages =
+            read_all_pages(None, Some(start.clone()), 100, server(250, 100, calls.clone()))
+                .unwrap();
+        assert_eq!(ids(&messages), (101..=250).collect::<Vec<_>>());
+        let calls = calls.borrow();
+        assert_eq!(calls.len(), 2);
+        assert_eq!(calls[0], (None, Some(start)));
+        assert_eq!(calls[1].1.as_deref(), Some(&msg(200).id[..]));
+    }
+    #[test]
+    fn read_all_includes_the_final_short_page() {
+        // 7 messages at limit 3: pages of 3, 3, then a short page of 1.
+        let calls = std::rc::Rc::new(std::cell::RefCell::new(Vec::new()));
+        let messages = read_all_pages(None, None, 3, server(7, 3, calls)).unwrap();
+        assert_eq!(ids(&messages), (1..=7).collect::<Vec<_>>());
+    }
+    #[test]
+    fn read_all_dedupes_overlapping_pages() {
+        let mut pages = vec![vec![msg(1), msg(2), msg(3)], vec![msg(1)]].into_iter();
+        let messages =
+            read_all_pages(None, None, 3, move |_, _| Ok(pages.next().unwrap_or_default()))
+                .unwrap();
+        assert_eq!(ids(&messages), vec![1, 2, 3]);
+    }
+    #[test]
+    fn read_all_fails_when_pages_stop_progressing() {
+        // A full page repeating forever must fail, not hang.
+        let result = read_all_pages(None, None, 3, |_, _| Ok(vec![msg(1), msg(2), msg(3)]));
+        assert!(result.is_err());
+        // An edge that repeats the cursor violates exclusivity; also a failure.
+        let cursor = msg(5).id;
+        let result = read_all_pages(None, Some(cursor), 2, |_, _| Ok(vec![msg(4), msg(5)]));
+        assert!(result.is_err());
+    }
+    #[test]
+    fn read_all_propagates_page_errors() {
+        let result = read_all_pages(None, None, 3, |_, _| anyhow::bail!("first page failed"));
+        assert!(result.is_err());
+        let mut first = true;
+        let result = read_all_pages(None, None, 3, move |_, _| {
+            if std::mem::replace(&mut first, false) {
+                Ok(vec![msg(1), msg(2), msg(3)])
+            } else {
+                anyhow::bail!("later page failed")
+            }
+        });
+        assert!(result.is_err());
+    }
+    #[test]
+    fn validate_read_rejects_before_any_request() {
+        for (limit, before, after) in [
+            (0, None, None),
+            (201, None, None),
+            (
+                50,
+                Some("01ARZ3NDEKTSV4RRFFQ69G5FAV"),
+                Some("01ARZ3NDEKTSV4RRFFQ69G5FAV"),
+            ),
+            (50, Some("not-a-ulid"), None),
+            (50, None, Some("not-a-ulid")),
+        ] {
+            assert!(validate_read(limit, before, after).is_err());
+        }
+        assert!(validate_read(1, None, None).is_ok());
+        assert!(validate_read(200, Some("01ARZ3NDEKTSV4RRFFQ69G5FAV"), None).is_ok());
+    }
+}
