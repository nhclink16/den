+
+#[tokio::test]
+async fn upload_admission_enforces_size_filename_and_pending_quota() {
+    let t = Test::new().await;
+    let alice = t.member("alice").await;
+    let bob = t.member("bob").await;
+    let cid = t.general().await;
+    let rows = || async {
+        sqlx::query_scalar::<_, i64>("SELECT count(*) FROM uploads")
+            .fetch_one(&t.state.db)
+            .await
+            .unwrap()
+    };
+    // Size bounds: the test server caps uploads at 1 MiB.
+    for size in [0, -1, 1024 * 1024 + 1] {
+        let r = t
+            .req(Method::POST, "/uploads", &alice.token)
+            .json(&json!({"channel_id":cid,"filename":"a.bin","content_type":"application/octet-stream","size":size}))
+            .send()
+            .await
+            .unwrap();
+        assert_eq!(r.status(), 413, "size {size}");
+        assert_eq!(r.json::<Value>().await.unwrap()["error"], "upload_size");
+    }
+    for filename in ["", "a/b", "a\\b", "has\u{7}control", &"x".repeat(256)] {
+        let r = t
+            .req(Method::POST, "/uploads", &alice.token)
+            .json(&json!({"channel_id":cid,"filename":filename,"content_type":"application/octet-stream","size":1}))
+            .send()
+            .await
+            .unwrap();
+        assert_eq!(r.status(), 400, "filename {filename:?}");
+        assert_eq!(r.json::<Value>().await.unwrap()["error"], "invalid_request");
+    }
+    // Rejected admission created neither an upload row nor a file.
+    assert_eq!(rows()().await, 0);
+    assert_eq!(std::fs::read_dir(t.dir.join("uploads")).unwrap().count(), 0);
+    // Boundary values are admitted: 255-byte filename, exactly max size.
+    let mut ids = Vec::new();
+    for (filename, size) in [
+        ("x".repeat(255), 1),
+        ("max.bin".into(), 1024 * 1024),
+        ("f2".into(), 1),
+        ("f3".into(), 1),
+        ("f4".into(), 1),
+    ] {
+        let upload = t
+            .post(
+                "/uploads",
+                &alice.token,
+                json!({"channel_id":cid,"filename":filename,"content_type":"application/octet-stream","size":size}),
+            )
+            .await;
+        ids.push(upload["id"].as_str().unwrap().to_string());
+    }
+    // The sixth pending upload for the same owner is a conflict.
+    let r = t
+        .req(Method::POST, "/uploads", &alice.token)
+        .json(&json!({"channel_id":cid,"filename":"six","content_type":"application/octet-stream","size":1}))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(r.status(), 409);
+    assert_eq!(r.json::<Value>().await.unwrap()["error"], "conflict");
+    assert_eq!(rows()().await, 5);
+    assert_eq!(std::fs::read_dir(t.dir.join("uploads")).unwrap().count(), 5);
+    // Another owner has an independent allowance.
+    t.post(
+        "/uploads",
+        &bob.token,
+        json!({"channel_id":cid,"filename":"bob.bin","content_type":"application/octet-stream","size":1}),
+    )
+    .await;
+    // Completing one of alice's pending uploads frees her slot.
+    let path = format!("/uploads/{}", ids[0]);
+    assert_eq!(
+        t.req(Method::PATCH, &path, &alice.token)
+            .header("Upload-Offset", 0)
+            .body("x")
+            .send()
+            .await
+            .unwrap()
+            .status(),
+        200
+    );
+    let done = t
+        .post(&format!("{path}/complete"), &alice.token, json!({}))
+        .await;
+    assert_eq!(done["complete"], true);
+    t.post(
+        "/uploads",
+        &alice.token,
+        json!({"channel_id":cid,"filename":"freed","content_type":"application/octet-stream","size":1}),
+    )
+    .await;
+    assert_eq!(rows()().await, 7);
+}
