+/// Fetch every matching message page. Backward walks (no cursor or `before`)
+/// start at the newest page and page toward older IDs; forward walks (`after`)
+/// start at the oldest page after the cursor and page toward newer IDs.
+/// Results are de-duplicated and returned in ascending message-ID order.
+fn read_all(
+    c: &Client,
+    channel_id: &str,
+    before: Option<String>,
+    after: Option<String>,
+    limit: u32,
+) -> anyhow::Result<Vec<Message>> {
+    read_all_pages(before, after, limit, |before, after| {
+        let mut path = format!("/channels/{channel_id}/messages?limit={limit}");
+        if let Some(v) = before {
+            path.push_str(&format!("&before={v}"));
+        }
+        if let Some(v) = after {
+            path.push_str(&format!("&after={v}"));
+        }
+        c.get(&path)
+    })
+}
+fn read_all_pages(
+    before: Option<String>,
+    after: Option<String>,
+    limit: u32,
+    mut fetch: impl FnMut(Option<&str>, Option<&str>) -> anyhow::Result<Vec<Message>>,
+) -> anyhow::Result<Vec<Message>> {
+    use std::collections::BTreeMap;
+    let forward = after.is_some();
+    let mut cursor_before = before;
+    let mut cursor_after = after;
+    let mut collected: BTreeMap<String, Message> = BTreeMap::new();
+    loop {
+        let page = fetch(cursor_before.as_deref(), cursor_after.as_deref())?;
+        let full = page.len() == limit as usize;
+        let fresh = page
+            .iter()
+            .any(|message| !collected.contains_key(&message.id));
+        // Pages arrive ascending: the walk edge is the oldest message going
+        // backwards, the newest going forwards.
+        let edge = if forward { page.last() } else { page.first() }.map(|m| m.id.clone());
+        for message in page {
+            collected.insert(message.id.clone(), message);
+        }
+        if !full {
+            break;
+        }
+        let edge = edge.expect("a full page is non-empty");
+        let prev = if forward { &cursor_after } else { &cursor_before };
+        let progressed = match prev {
+            Some(prev) if forward => edge > *prev,
+            Some(prev) => edge < *prev,
+            None => true,
+        };
+        anyhow::ensure!(
+            fresh && progressed,
+            "Message pages stopped progressing at message {edge}"
+        );
+        if forward {
+            cursor_after = Some(edge);
+        } else {
+            cursor_before = Some(edge);
+        }
+    }
+    Ok(collected.into_values().collect())
+}
