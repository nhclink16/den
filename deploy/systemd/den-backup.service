[Unit]
Description=Back up Den database and uploads to codexbox
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=den
Group=den
Environment=DEN_DB=/var/lib/den/den.db
Environment=DEN_UPLOADS=/var/lib/den/uploads
ExecStartPre=+/usr/bin/systemctl stop den-server.service
ExecStart=/opt/den/bin/backup.sh snapshot
ExecStart=+/usr/bin/systemctl start den-server.service
ExecStart=/opt/den/bin/backup.sh transfer
ExecStopPost=+/usr/bin/systemctl start den-server.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/den
PrivateTmp=true
UMask=0077
