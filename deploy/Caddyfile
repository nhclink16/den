{
	https_port 8443
	servers {
		protocols h1 h2
	}
}

denchat.app {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	request_body {
		max_size 1100MB
	}
	reverse_proxy 127.0.0.1:7000
}

rtc.denchat.app {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy 127.0.0.1:7880
}

