{
	https_port 8443
	servers {
		protocols h1 h2
	}
}

denchat.app {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	request_body {
		max_size 1100MB
	}

	# Exactly "/" serves the static download page; every other path, including
	# /login, /c/*, /health and the whole API, still reaches den-server
	# untouched. The page lives in /opt/den/download, NOT /opt/den/web, because
	# deploy/release.sh rsyncs the web root with --delete and would erase it.
	handle / {
		root * /opt/den/download
		rewrite * /index.html
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:7000
	}
}

rtc.denchat.app {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	reverse_proxy 127.0.0.1:7880
}

# Keep previously shared links, including invite queries, working.
den.nicholascaron.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	redir https://denchat.app{uri} 301
}

rtc.den.nicholascaron.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	redir https://rtc.denchat.app{uri} 301
}
